#include <stdio.h>
#include <string.h>

int main(void) {
    char nomeEstudante[50];
    char codigoCurso[10];
    char nomeCopia[50];
    char mensagem[100] = "Ola, ";

    printf("===== IDENTIFICACAO ACADEMICA =====\n\n");
    
    printf("Nome do estudante: ");
    scanf("%49s", nomeEstudante);
    
    printf("Codigo do curso: ");
    scanf("%9s", codigoCurso);
    
    printf("\n===== RESULTADO =====\n");
    printf("Estudante: %s\n", nomeEstudante);
    
    if (strcmp(codigoCurso, "CC") == 0) {
        printf("Curso: Ciencia da Computacao\n");
    } else if (strcmp(codigoCurso, "SI") == 0) {
        printf("Curso: Sistemas de Informacao\n");
    } else {
        printf("Curso: Desconhecido\n");
    }
    
    printf("Caracteres no nome: %zu\n\n", strlen(nomeEstudante));
    
    strcpy(nomeCopia, nomeEstudante);
    strcat(mensagem, nomeCopia);
    strcat(mensagem, "!");
    
    printf("%s\n", mensagem);

    return 0;
}
