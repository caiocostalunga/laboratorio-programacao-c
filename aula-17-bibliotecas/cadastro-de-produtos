#include <stdio.h>
#include <string.h>

int main(void) {
    char produto[50];
    char categoria[30];
    char produtoCopia[50];
    char descricao[100] = "Produto: ";

    printf("===== CADASTRO DE PRODUTOS =====\n\n");
    
    printf("Nome do produto: ");
    scanf("%49s", produto);
    
    printf("Categoria: ");
    scanf("%29s", categoria);
    
    printf("\n===== RESUMO =====\n");
    printf("Produto: %s\n", produto);
    printf("Caracteres: %zu\n", strlen(produto));
    
    if (strcmp(categoria, "PERIFERICO") == 0) {
        printf("Categoria: Periferico\n");
    } else {
        printf("Categoria: Hardware\n");
    }
    
    strcpy(produtoCopia, produto);
    strcat(descricao, produtoCopia);
    
    printf("Descricao: %s\n", descricao);
    printf("Cadastro concluido!\n");

    return 0;
}
