#include <stdio.h>

typedef struct {
    char nome[50];
    float salario;
    int horasExtras;
} Funcionario;

int main(void) {
    FILE *arquivo;
    Funcionario funcionario;
    int quantidade;

    printf("Quantos funcionarios deseja cadastrar (1 a 5)? ");
    scanf("%d", &quantidade);

    if (quantidade < 1 || quantidade > 5) {
        printf("Quantidade invalida!\n");
        return 1;
    }

    arquivo = fopen("funcionarios.txt", "a");

    if (arquivo == NULL) {
        printf("Erro ao abrir arquivo!\n");
        return 1;
    }

    for (int i = 0; i < quantidade; i++) {
        printf("\nFuncionario %d\n", i + 1);

        printf("Nome: ");
        scanf(" %49[^\n]", funcionario.nome);

        printf("Salario: ");
        scanf("%f", &funcionario.salario);

        printf("Horas extras: ");
        scanf("%d", &funcionario.horasExtras);

        fprintf(arquivo, "%s;%.2f;%d\n",
                funcionario.nome,
                funcionario.salario,
                funcionario.horasExtras);
    }

    fclose(arquivo);

    printf("\nFuncionarios cadastrados com sucesso!\n");

    arquivo = fopen("funcionarios.txt", "r");

    if (arquivo == NULL) {
        printf("Erro ao ler arquivo!\n");
        return 1;
    }

    printf("\n===== FUNCIONARIOS CADASTRADOS =====\n");

    printf("%-25s %-12s %-12s\n",
           "NOME", "SALARIO", "HORAS EXTRAS");

    while (fscanf(arquivo, " %49[^;];%f;%d",
                  funcionario.nome,
                  &funcionario.salario,
                  &funcionario.horasExtras) == 3) {

        printf("%-25s R$ %-9.2f %-12d\n",
               funcionario.nome,
               funcionario.salario,
               funcionario.horasExtras);
    }

    fclose(arquivo);

    return 0;
}
