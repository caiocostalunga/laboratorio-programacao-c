#include <stdio.h>

typedef struct {
    char nome[50];
    int matricula;
} Funcionario;

int main(void) {
    Funcionario funcionarios[5];
    FILE *arquivo;
    int quantidade, i;

    printf("Quantos funcionarios deseja cadastrar (1 a 5)? ");
    scanf("%d", &quantidade);

    if (quantidade < 1 || quantidade > 5) {
        printf("Quantidade invalida!\n");
        return 1;
    }

    for (i = 0; i < quantidade; i++) {
        printf("\nFuncionario %d\n", i + 1);

        printf("Nome: ");
        scanf(" %49[^\n]", funcionarios[i].nome);

        printf("Matricula: ");
        scanf("%d", &funcionarios[i].matricula);
    }

    arquivo = fopen("funcionarios.txt", "w");

    if (arquivo == NULL) {
        printf("Erro ao criar o arquivo.\n");
        return 1;
    }

    for (i = 0; i < quantidade; i++) {
        fprintf(arquivo, "Nome: %s\n", funcionarios[i].nome);
        fprintf(arquivo, "Matricula: %d\n\n", funcionarios[i].matricula);
    }

    if (fclose(arquivo) == 0) {
        printf("\nDados gravados com sucesso em funcionarios.txt!\n");
    } else {
        printf("Erro ao salvar os dados.\n");
    }

    return 0;
}
