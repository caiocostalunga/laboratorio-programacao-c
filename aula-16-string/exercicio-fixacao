2. Ler e exibir o nome completo de uma pessoa:(Utilizei fgets para permitir a leitura de espaços no nome completo).
#include <stdio.h>

int main() {
    char nome[100];

    printf("Digite seu nome completo: ");
    fgets(nome, sizeof(nome), stdin);

    printf("Nome completo: %s", nome);

    return 0;
}

3. Ler uma palavra e apresentar somente seu primeiro caractere:

C
#include <stdio.h>

int main() {
    char palavra[50];

    printf("Digite uma palavra: ");
    scanf("%s", palavra);

    // O primeiro caractere está na posição 0 do vetor
    printf("O primeiro caractere e: %c\n", palavra[0]);

    return 0;
}

4. Ler uma palavra e exibir cada caractere em uma linha:

C
#include <stdio.h>

int main() {
    char palavra[50];

    printf("Digite uma palavra: ");
    scanf("%s", palavra);

    for (int i = 0; palavra[i] != '\0'; i++) {
        printf("%c\n", palavra[i]);
    }

    return 0;
}

5. Ler uma palavra e contar quantas vogais ela possui (considerando minúsculas):

C
#include <stdio.h>

int main() {
    char palavra[50];
    int vogais = 0;

    printf("Digite uma palavra (letras minusculas): ");
    scanf("%s", palavra);

    for (int i = 0; palavra[i] != '\0'; i++) {
        if (palavra[i] == 'a' || palavra[i] == 'e' || palavra[i] == 'i' || 
            palavra[i] == 'o' || palavra[i] == 'u') {
            vogais++;
        }
    }

    printf("Quantidade de vogais minusculas: %d\n", vogais);

    return 0;
}

